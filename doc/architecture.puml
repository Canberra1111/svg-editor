@startuml
title Lab1 Phase 1 SVG Editor
skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
component "main\nWiring" as main
component "cli\nTokenizer\nTerminal" as cli
component "application\nCommands\nSession\nHistory" as app
interface "DocumentStore" as port
component "domain\nShape / Group\nSvgDocument" as domain
component "infrastructure\nFile store\nSVG codec" as infra
main --> cli
main --> app
main --> infra
cli --> app
app --> domain
app --> port
infra ..|> port
infra --> domain
@enduml
